# Copy this file to .env and fill in your real NAVER API HUB credentials.
# Get credentials at https://www.ncloud.com/product/applicationService/naverApiHub
# (NCP console -> Application -> 인증 정보). These are NOT the classic
# developers.naver.com Client ID/Secret - main.py calls the API HUB gateway
# (naveropenapi.apigw.ntruss.com) with X-NCP-APIGW-API-KEY-ID/-KEY headers.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional overrides (safe to leave unset — defaults shown below)
# NAVER_SHOPPING_CATEGORY_CODE=50000003
# LOG_LEVEL=INFO
# FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173
